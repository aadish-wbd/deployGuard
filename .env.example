# AWS / Bedrock (Inline Agent — no pre-created agent needed)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# AgentCore Harness (optional — enables JIRA/Slack/GitHub tool orchestration)
# If empty, falls back to Converse API (no tool calling)
AGENTCORE_HARNESS_ARN=arn:aws:bedrock-agentcore:us-east-1:657246005217:harness/DeployGuard-Yl3XVxONZV

# Knowledge Bases (optional — provide IDs if you have them)
CODE_KNOWLEDGE_BASE_ID=
METRICS_KNOWLEDGE_BASE_ID=
KB_NUMBER_OF_RESULTS=8

# AWS Secrets Manager (EC2/production — app loads secrets at startup; leave unset for local .env secrets below)
# SECRETS_MANAGER_SECRET_ARN=arn:aws:secretsmanager:us-east-1:657246005217:secret:deployguard-dev/app-credentials-t99KAJ
SECRETS_MANAGER_SECRET_NAME=deployguard-dev/app-credentials-t99KAJ

# --- Non-secrets (safe in /etc/deployguard.env on EC2) ---
ENABLE_JIRA=true
JIRA_BASE_URL=https://wbdprod.atlassian.net/
JIRA_CLOUD_ID=5a6c042a-690a-4e05-b7d0-2646424fa85e
JIRA_PROJECT_KEY=UA
JIRA_ISSUE_TYPE=Task

ENABLE_SLACK=true
SLACK_CHANNEL=#hackathon
SLACK_ONCALL_MENTIONS=[]

# --- Secrets (local dev only — use Secrets Manager on EC2; never commit real values) ---
GITHUB_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
SLACK_BOT_TOKEN=

# Databricks (optional)
DATABRICKS_HOST=
DATABRICKS_DEFAULT_ENVIRONMENT=production
