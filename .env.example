# AWS / Bedrock (Inline Agent — no pre-created agent needed)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# AgentCore Harness (optional — enables JIRA/Slack/GitHub tool orchestration)
# If empty, falls back to Converse API (no tool calling)
AGENTCORE_HARNESS_ARN=

# Knowledge Bases (optional — provide IDs if you have them)
CODE_KNOWLEDGE_BASE_ID=
METRICS_KNOWLEDGE_BASE_ID=
KB_NUMBER_OF_RESULTS=8

SECRETS_MANAGER_SECRET_NAME=deployguard-dev/app-credentials

# GitHub (read-only PAT)
GITHUB_TOKEN=

# JIRA Cloud
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=

# Slack
SLACK_WEBHOOK_URL=

# Optional defaults when omitted in request payload
DEFAULT_JIRA_PROJECT_KEY=OPS
DEFAULT_SLACK_CHANNEL=#incidents


DATABRICKS_HOST=https://wbd-disc-dev-adsci-test-workspace.cloud.databricks.com/