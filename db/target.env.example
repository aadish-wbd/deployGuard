# DeployGuard PostgreSQL target — Terraform-managed Aurora (same VPC as EC2)
#
# After: terraform apply
#   - Endpoint and credentials are in Secrets Manager: deployguard-dev/database
#   - Non-secret vars are on EC2 in /etc/deployguard.env (PGHOST, PGPORT, etc.)
#
# Apply schema once (from a host that can reach the cluster, e.g. DeployGuard EC2 via SSM):
#   export PGHOST="<aurora_cluster_endpoint from terraform output>"
#   export PGPORT=5432
#   export PGUSER=deployguard
#   export PGPASSWORD="$(aws secretsmanager get-secret-value --secret-id deployguard-dev/database --query SecretString --output text | python3 -c 'import json,sys; print(json.load(sys.stdin)["password"])')"
#   ./db/apply_schema.sh
#
# Note: skip 00_create_database.sql — Terraform already creates the deployguard database.

PGHOST=<from terraform output aurora_cluster_endpoint>
PGPORT=5432
PGUSER=deployguard
PGDATABASE=deployguard

# Full connection JSON: Secrets Manager deployguard-dev/database
